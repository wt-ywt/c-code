.page {
  padding: 24rpx 24rpx 60rpx;
}

.status {
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.status.ok {
  background: #e8f7ef;
}

.status.warn {
  background: #fff4e8;
}

.status-title {
  font-size: 28rpx;
  font-weight: 600;
}

.status.ok .status-title {
  color: #1f8a54;
}

.status.warn .status-title {
  color: #c26a12;
}

.status-desc {
  margin-top: 8rpx;
  color: #8a8f99;
  font-size: 22rpx;
  line-height: 1.6;
}

.card {
  margin-bottom: 20rpx;
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
}

.card-title {
  padding: 20rpx 0 8rpx;
  font-size: 26rpx;
  color: #8a8f99;
}

.row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
}

.row-title {
  font-size: 28rpx;
}

.row-desc {
  margin-top: 6rpx;
  color: #8a8f99;
  font-size: 22rpx;
}

.picker {
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  background: #f2f5ff;
  color: #4a7cff;
  font-size: 25rpx;
}

.mini-btn {
  padding: 10rpx 22rpx;
  border-radius: 10rpx;
  background: #4a7cff;
  color: #fff;
  font-size: 24rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 8rpx;
}

.grid-item {
  width: 25%;
  padding: 10rpx 0;
  text-align: center;
}

.grid-label {
  color: #8a8f99;
  font-size: 20rpx;
}

.grid-val {
  margin-top: 6rpx;
  padding: 8rpx 0;
  border-radius: 8rpx;
  background: #f2f5ff;
  color: #4a7cff;
  font-size: 24rpx;
}

.hint {
  padding: 12rpx 0;
  color: #a8adb8;
  font-size: 22rpx;
  line-height: 1.65;
}
